rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isPrivileged() {
        let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
        return userRole == 'professor' || userRole == 'super_admin';
    }

    match /reports/{reportId} {
      allow create: if request.auth.uid == request.resource.data.reporterId;
      allow read, update: if isPrivileged();
      allow delete: if false;
    }
    
    match /professor_applications/{userId} {
      allow create: if request.auth.uid == userId;
      allow read, update, delete: if isPrivileged();
    }

    match /users/{userId} {
      allow read: if request.auth != null; 
      allow create, update: if isOwner(userId);
      // Impede que super_admins sejam deletados pelo app
      allow delete: if resource.data.role != 'super_admin';

      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.authorId && isPrivileged();
      allow update: if request.auth.uid == resource.data.authorId || (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']) && request.resource.data.commentCount == resource.data.commentCount + 1);
      allow delete: if request.auth.uid == resource.data.authorId;

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth.uid == resource.data.authorId;
        allow update: if false;
      }
    }

    match /hubs/{hubId} {
      // CORREÇÃO: A regra de leitura/escrita interna estava muito permissiva
      // e a de criação não validava o owner.
      function isMember() {
        return request.auth.uid in get(/databases/$(database)/documents/hubs/$(hubId)).data.memberIds;
      }
      
      allow get, list: if request.auth != null;
      // Garante que o usuário criando o Hub seja o dono dele.
      allow create: if request.auth.uid == request.resource.data.ownerId; 
      allow update: if isMember();
      allow delete: if request.auth.uid == resource.data.ownerId; 

      match /mind_maps/{docId} {
        allow read, write: if isMember();
      }
      match /events/{eventId} {
        allow read, write: if isMember();
      }
      // Adicione outras sub-coleções aqui com regras específicas
    }

    match /chatRooms/{roomId} {
      allow read, list: if request.auth.uid in resource.data.memberIds;
      allow update, create: if request.auth.uid in request.resource.data.memberIds;
      allow delete: if request.auth.uid == get(/databases/$(database)/documents/hubs/$(roomId)).data.ownerId;
      match /messages/{messageId} {
        allow read, create: if request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.memberIds;
      }
    }
    
    match /hub_invites/{inviteId} {
      allow read, update: if request.auth.uid == resource.data.toUserId;
      allow create: if request.auth.uid == request.resource.data.fromUserId;
    }

    match /topics/{topicId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.authorId;
      allow update, delete: if request.auth.uid == resource.data.authorId;
      match /replies/{replyId} {
        allow read: if request.auth != null;
        allow create: if (request.auth.uid == request.resource.data.authorId)
                      && (get(/databases/$(database)/documents/topics/$(topicId)).data.isClosed == false);
        allow update, delete: if request.auth.uid == resource.data.authorId;
      }
    }
    
  }
}
