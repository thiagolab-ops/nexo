rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isPrivileged() {
        let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
        return userRole == 'professor' || userRole == 'super_admin';
    }

    match /reports/{reportId} {
      allow create: if request.auth.uid == request.resource.data.reporterId;
      allow read, update: if isPrivileged();
      allow delete: if false;
    }
    
    match /professor_applications/{applicationId} {
      allow create: if request.auth.uid == request.resource.data.userId;
      allow read, delete: if isPrivileged();
      allow update: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null; 
      allow create: if isOwner(userId);
      // CORREÇÃO: Permite a atualização pelo próprio dono OU
      // por um admin, mas SOMENTE se a única alteração for no campo 'role'.
      allow update: if isOwner(userId) || 
                      (isPrivileged() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']));
      allow delete: if resource.data.role != 'super_admin';

      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.authorId && isPrivileged();
      allow update: if request.auth.uid == resource.data.authorId || (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']));
      allow delete: if request.auth.uid == resource.data.authorId;

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth.uid == resource.data.authorId;
        allow update: if false;
      }
    }

    match /hubs/{hubId} {
      function isMember() {
        return request.auth.uid in get(/databases/$(database)/documents/hubs/$(hubId)).data.memberIds;
      }
      
      allow get, list: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.ownerId; 
      allow update: if isMember();
      allow delete: if request.auth.uid == resource.data.ownerId; 

      match /{allPaths=**} {
        allow read, write: if isMember();
      }
    }

    match /chatRooms/{roomId} {
      allow get: if request.auth.uid in roomId.split('_') || request.auth.uid in resource.data.memberIds;
      allow list: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth.uid in request.resource.data.memberIds && (request.resource.data.type == 'group' || request.resource.data.memberIds.size() == 2);
      allow update: if request.auth.uid in resource.data.memberIds;

      match /messages/{messageId} {
        allow read, create: if request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.memberIds;
      }
    }
    
    match /hub_invites/{inviteId} {
      allow read, update: if request.auth.uid == resource.data.toUserId;
      allow create: if request.auth.uid == request.resource.data.fromUserId;
    }

    match /topics/{topicId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.authorId;
      allow update, delete: if request.auth.uid == resource.data.authorId;
      match /replies/{replyId} {
        allow read: if request.auth != null;
        allow create: if (request.auth.uid == request.resource.data.authorId) && (get(/databases/$(database)/documents/topics/$(topicId)).data.isClosed == false);
        allow update, delete: if request.auth.uid == resource.data.authorId;
      }
    }
  }
}
