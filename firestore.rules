rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isProfessor(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role == 'professor';
    }

    match /reports/{reportId} {
      allow create: if request.auth.uid == request.resource.data.reporterId;
      allow read, update, delete: if false;
    }
    
    // --- NOVA REGRA PARA APLICAÇÕES DE PROFESSOR ---
    match /professor_applications/{userId} {
      // Permite que um usuário crie uma aplicação APENAS para si mesmo.
      // Ninguém pode ler ou modificar as aplicações dos outros via app.
      allow create: if request.auth.uid == userId;
      allow read, update, delete: if false;
    }
    // --- FIM DA REGRA ---

    match /users/{userId} {
      allow read: if request.auth != null; 
      allow create, update: if isOwner(userId);

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
      match /professor_stats/{statId} {
        allow read: if isOwner(userId);
      }
      match /baralhos/{baralhoId} {
        allow read, write, delete: if isOwner(userId);
        match /cards/{cardId} {
          allow read, write, delete: if isOwner(userId);
        }
      }
      match /nexo_pad_documents/{docId} {
         allow read, write, delete: if isOwner(userId);
      }
      match /quizzes/{quizId} {
        allow read, write, delete: if isOwner(userId);
      }
      match /videoteca/{videoId} {
        allow read: if request.auth != null;
        allow write, delete: if isOwner(userId);
      }
      match /cursos/{cursoId} {
        allow read: if request.auth != null;
        allow write, delete: if isOwner(userId);
        allow update: if request.auth != null 
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratings']);
        match /lessons/{lessonId} {
          allow read: if request.auth != null;
          allow write, delete: if isOwner(userId);
          match /comments/{commentId} {
            allow read: if request.auth != null;
            allow create: if request.auth.uid == request.resource.data.authorId;
            allow update, delete: if request.auth.uid == resource.data.authorId;
          }
        }
      }
    }

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.authorId && isProfessor(request.auth.uid);
      allow update: if request.auth.uid == resource.data.authorId || (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']) && request.resource.data.commentCount == resource.data.commentCount + 1);
      allow delete: if request.auth.uid == resource.data.authorId;

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth.uid == resource.data.authorId;
        allow update: if false;
      }
    }

    match /hubs/{hubId} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth.uid in get(/databases/$(database)/documents/hubs/$(hubId)).data.memberIds;
      allow delete: if request.auth.uid == resource.data.ownerId; 
      match /{document=**} { 
        allow read, write, delete: if request.auth.uid in get(/databases/$(database)/documents/hubs/$(hubId)).data.memberIds;
      }
    }

    match /chatRooms/{roomId} {
      allow read, list: if request.auth.uid in resource.data.memberIds;
      allow update, create: if request.auth.uid in request.resource.data.memberIds;
      allow delete: if request.auth.uid == get(/databases/$(database)/documents/hubs/$(roomId)).data.ownerId;
      match /messages/{messageId} {
        allow read, create: if request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.memberIds;
      }
    }
    
    match /hub_invites/{inviteId} {
      allow read, update: if request.auth.uid == resource.data.toUserId;
      allow create: if request.auth.uid == request.resource.data.fromUserId;
    }

    match /topics/{topicId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.authorId;
      allow update, delete: if request.auth.uid == resource.data.authorId;
      match /replies/{replyId} {
        allow read: if request.auth != null;
        allow create: if (request.auth.uid == request.resource.data.authorId)
                      && (get(/databases/$(database)/documents/topics/$(topicId)).data.isClosed == false);
        allow update, delete: if request.auth.uid == resource.data.authorId;
      }
    }
    
  }
}
