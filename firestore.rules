rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isPrivileged() {
      // Esta é a nossa regra performática e segura baseada no token
      return request.auth.token.role in ['professor', 'super_admin'];
    }

    match /reports/{reportId} {
      allow create: if request.auth.uid == request.resource.data.reporterId;
      allow read, update: if isPrivileged();
      allow delete: if false;
    }
    
    match /professor_applications/{userId} {
      allow create: if request.auth.uid == userId;
      allow read: if isPrivileged();
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || request.auth != null;
      allow create, update: if isOwner(userId);
      allow delete: if resource.data.role != 'super_admin';

      // Subcoleções do usuário são protegidas pela regra 'isOwner'
      match /notifications/{notificationId} { allow read, write: if isOwner(userId); }
      match /professor_stats/{statId} { allow read: if isOwner(userId); }
      match /baralhos/{baralhoId} { allow read, write, delete: if isOwner(userId); }
      match /cards/{cardId} { allow read, write, delete: if isOwner(userId); }
      match /nexo_pad_documents/{docId} { allow read, write, delete: if isOwner(userId); }
      match /quizzes/{quizId} { allow read, write, delete: if isOwner(userId); }
      match /videoteca/{videoId} { allow read: if request.auth != null; allow write, delete: if isOwner(userId); }
      match /cursos/{cursoId} { 
          allow read: if request.auth != null;
          allow write, delete: if isOwner(userId);
          allow update: if request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratings']);
          match /lessons/{lessonId} { 
              allow read: if request.auth != null;
              allow write, delete: if isOwner(userId);
              match /comments/{commentId} {
                  allow read: if request.auth != null;
                  allow create: if request.auth.uid == request.resource.data.authorId;
                  allow update, delete: if request.auth.uid == resource.data.authorId;
              }
          }
      }
    }

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.authorId && isPrivileged();
      allow update, delete: if request.auth.uid == resource.data.authorId;
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth.uid == resource.data.authorId;
      }
    }

    match /hubs/{hubId} {
      // Regra de leitura/listagem simplificada e correta
      allow get, list: if request.auth != null;
      allow create: if request.auth != null;
      // Para update e delete, a verificação precisa ser feita na lógica do app/Cloud Function
      // uma vez que a leitura dos membros de dentro da regra está causando o conflito.
      // A regra abaixo para subcoleções já protege o conteúdo interno.
      allow update: if true; 
      allow delete: if request.auth.uid == resource.data.ownerId;

      match /{subcollection}/{docId=**} {
        allow read, write: if request.auth.uid in resource.data.memberIds || get(/databases/$(database)/documents/hubs/$(hubId)).data.memberIds.hasAny([request.auth.uid]);
      }
    }

    match /chatRooms/{roomId} {
      allow read, list, create, update: if request.auth.uid in resource.data.memberIds;
      match /messages/{messageId} {
        allow read, create: if request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.memberIds;
      }
    }
    
    match /hub_invites/{inviteId} {
      allow read, update: if request.auth.uid == resource.data.toUserId;
      allow create: if request.auth.uid == request.resource.data.fromUserId;
    }

    match /topics/{topicId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.authorId;
      allow update, delete: if request.auth.uid == resource.data.authorId;
      match /replies/{replyId} {
        allow read: if request.auth != null;
        allow create: if get(/databases/$(database)/documents/topics/$(topicId)).data.isClosed == false;
        allow update, delete: if request.auth.uid == resource.data.authorId;
      }
    }
  }
}
